{
  // Cấu hình mặc định, dùng chung cho mọi môi trường.
  // Nhà cung cấp cấu hình JSON của ASP.NET Core bỏ qua comment, nên các dòng // ở đây là hợp lệ.
  //
  // QUY TẮC: file này nằm trong git, nên KHÔNG chứa bí mật nào.
  // Mọi giá trị nhạy cảm để trống ở đây và đặt bằng biến môi trường lúc deploy.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Câu SQL do EF Core sinh ra rất dài; chỉ bật lên Information khi đang gỡ lỗi truy vấn.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Để trống. Production đặt biến môi trường ConnectionStrings__DefaultConnection,
    // hoặc DATABASE_URL dạng URI (Neon và phần lớn PaaS phát sẵn biến này) —
    // xem Infrastructure/DependencyInjection.ResolveConnectionString.
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "Anthill",
    "Audience": "Anthill.Client",

    // BẮT BUỘC để trống ở file này.
    // Production PHẢI đọc khoá từ biến môi trường Jwt__SecretKey (hoặc JWT_SECRET_KEY).
    // Khoá phải dài tối thiểu 32 byte, nếu không HS256 không ký được và API chết ngay lúc khởi động.
    // Sinh khoá: openssl rand -base64 48
    // Khoá dùng cho máy lập trình nằm ở appsettings.Development.json và chỉ có giá trị ở đó.
    "SecretKey": "",

    // Học sinh làm bài 45–60 phút; token hết hạn giữa chừng là mất bài.
    "ExpiryMinutes": 120
  },

  "FileStorage": {
    // Ảnh câu hỏi. Bản cài đặt hiện tại ghi xuống đĩa của chính máy chạy API.
    // LƯU Ý KHI DEPLOY: Render xoá sạch đĩa mỗi lần khởi động lại, nên ảnh sẽ biến mất sau lần
    // deploy kế tiếp. Production phải chuyển sang Cloudinary — thêm một lớp cài đặt IFileService
    // và đổi dòng AddSingleton trong Infrastructure/DependencyInjection.AddFileStorage.
    "RootPath": "wwwroot",
    "UploadFolder": "uploads",

    // Phải khớp đường dẫn mà UseUploadedFiles gắn vào, nếu không URL trả về sẽ trỏ vào hư không.
    "RequestPath": "/uploads",

    // 4 MB. Đủ cho một ảnh chụp đề bài, và đủ nhỏ để học sinh dùng 3G vẫn tải được trong lúc làm bài.
    "MaxBytes": 4194304
  },

  "Cors": {
    // Liệt kê cụ thể, KHÔNG dùng "*": SignalR cần AllowCredentials, mà trình duyệt từ chối thẳng
    // cặp AllowAnyOrigin + AllowCredentials ngay từ preflight.
    //
    // ĐỂ TRỐNG Ở ĐÂY LÀ CÓ CHỦ ĐÍCH. Danh sách này không có địa chỉ mặc định nào, kể cả một mẫu
    // "https://*.vercel.app" trông vô hại: mẫu đó cho phép mọi trang bất kỳ ai deploy lên Vercel gọi
    // API bằng trình duyệt của người đang đăng nhập. Production PHẢI khai địa chỉ thật của frontend
    // bằng biến môi trường Cors__AllowedOrigins__0 (thêm __1, __2... nếu có nhiều), nếu không API
    // dừng ngay lúc khởi động — xem ValidateSecurityConfiguration.
    //
    // Cấu hình dạng mảng bị đè theo TỪNG CHỈ SỐ, nên để trống ở đây cũng tránh chuyện đặt biến môi
    // trường cho chỉ số 0 mà chỉ số 1 của file này vẫn còn hiệu lực.
    "AllowedOrigins": []
  }
}
