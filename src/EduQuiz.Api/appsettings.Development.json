{
  // Cấu hình cho máy lập trình. Đè lên appsettings.json khi ASPNETCORE_ENVIRONMENT=Development.
  //
  // Mọi giá trị ở đây CHỈ dùng cho môi trường dev. Không bê nguyên sang production —
  // đặc biệt là Jwt:SecretKey.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Đổi thành "Information" khi cần xem câu SQL mà EF Core sinh ra.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    // PostgreSQL cài trên máy. Sửa lại Username/Password cho khớp máy bạn.
    "DefaultConnection": "Host=localhost;Port=5432;Database=eduquiz;Username=postgres;Password=postgres"
  },

  "Jwt": {
    // KHOÁ DEV, CÔNG KHAI, KHÔNG CÓ GIÁ TRỊ BẢO MẬT NÀO.
    // Nó nằm trong git nên coi như cả thế giới đều biết. Production BẮT BUỘC đặt khoá riêng
    // bằng biến môi trường Jwt__SecretKey; dùng lại chuỗi này trên production đồng nghĩa
    // bất kỳ ai cũng tự ký được token quản trị viên.
    // Dài 62 ký tự ASCII, vượt mức tối thiểu 32 byte của HS256.
    "SecretKey": "eduquiz-dev-only-signing-key-doi-truoc-khi-len-production-2026",

    // Rộng rãi hơn production để khỏi phải đăng nhập lại giữa buổi làm việc.
    "ExpiryMinutes": 480
  },

  "Cors": {
    // Cấu hình dạng mảng được đè theo TỪNG CHỈ SỐ, nên danh sách dưới thay chỗ hai origin
    // production của appsettings.json — ở dev không còn origin *.vercel.app nào được phép.
    //
    // Có cả bản http lẫn https của mỗi cổng, vì hai giao thức là HAI ORIGIN KHÁC NHAU với trình
    // duyệt. Thiếu bản https thì lúc demo mà bật HTTPS lên, mọi lời gọi API chết ngay từ preflight
    // — và đó là kiểu lỗi chỉ lộ ra đúng lúc không muốn nó lộ ra nhất.
    //
    // LƯU Ý về mixed content: frontend chạy HTTPS thì BẮT BUỘC phải gọi API qua HTTPS. Trình duyệt
    // chặn thẳng lời gọi http từ một trang https, không phải bằng CORS mà bằng một luật riêng
    // không có cách nào tắt. Hai bên phải cùng giao thức.
    "AllowedOrigins": [
      // Vite dev server
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://localhost:5173",
      "https://127.0.0.1:5173",

      // vite preview (chạy thử bản build)
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "https://localhost:4173",
      "https://127.0.0.1:4173"
    ]
  }
}
